# ---------------------------------------------------------------
# Obrigatorias (a aplicacao nao arranca em producao sem elas)
# ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Gerar com: npx auth secret   (minimo 32 caracteres)
AUTH_SECRET=
DATABASE_URL="postgresql://user:password@localhost:5432/viajando?schema=public"

# Stripe (obrigatorio em producao). Ativar cartao, MB WAY e Multibanco em
# Dashboard > Settings > Payment methods. Webhook: /api/webhooks/stripe com os eventos
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, charge.refunded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Opcionais
# ---------------------------------------------------------------
# Login com Google (o botao so aparece se ambos estiverem definidos)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Amadeus (pesquisa de voos). Sem credenciais, a pesquisa usa dados de demonstracao
# fora de producao e mostra "indisponivel" em producao.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_ENVIRONMENT=test
AMADEUS_ACTIVE=true

# Forca/desliga os resultados de demonstracao (por omissao: ligados so fora de producao)
# ENABLE_DEMO_DATA=false

# Cache e rate limiting partilhados (Upstash Redis / Vercel KV).
# Obrigatorio em producao com mais do que uma instancia: sem isto a cache e em memoria.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Email transacional (confirmacoes de reserva e formulario de contacto)
# ex.: smtp://user:pass@smtp.resend.com:587
SMTP_URL=
EMAIL_FROM="Viajando <no-reply@example.com>"

# Contactos publicos mostrados na pagina de contacto (so aparecem se definidos)
SUPPORT_EMAIL=
SUPPORT_PHONE=
COMPANY_ADDRESS=

# Protege /api/cron/expire-bookings (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
